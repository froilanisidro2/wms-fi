# Environment variables for WMS-FI
# Copy this file to .env and update with your actual values

# Database Configuration
DB_NAME=wms-fi
DB_USER=postgres
DB_PASSWORD=postgres
DB_HOST=localhost
DB_PORT=5432

# API Configuration
NODE_ENV=development
API_PORT=3001

# JWT Secret (change this to a secure random string)
JWT_SECRET=your-super-secret-jwt-token-with-at-least-32-characters-for-production

# PostgREST Configuration
POSTGREST_PORT=3000

# Frontend Configuration
REACT_APP_API_URL=http://localhost:3001
REACT_APP_POSTGREST_URL=http://localhost:3000

# File Upload Configuration
UPLOAD_MAX_SIZE=10MB
UPLOAD_DIR=./uploads

# Google Sheets Integration (optional)
GOOGLE_SHEETS_API_KEY=
GOOGLE_SHEETS_CLIENT_ID=
GOOGLE_SHEETS_CLIENT_SECRET=

# Email Configuration (for notifications)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=

# Philippine Localization
TIMEZONE=Asia/Manila
CURRENCY=PHP
LOCALE=en-PH

# Barcode Configuration
BARCODE_PREFIX=WMS
BARCODE_LENGTH=12

# Printer Configuration (for label printing)
LABEL_PRINTER_IP=
LABEL_PRINTER_PORT=9100